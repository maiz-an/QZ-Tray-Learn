# Copy this file to .env and adjust as needed (optional — all values
# have sane defaults in server.js).

PORT=3000

# Absolute paths to your QZ Tray key pair, if you don't want to keep
# them in the default ./certs folder.
# QZ_CERT_FILE=/absolute/path/to/digital-certificate.txt
# QZ_PRIVATE_KEY_FILE=/absolute/path/to/private-key.pem

# Optional: a logo image URL to print on the test receipt.
# Only used if CONFIG.useLogo is set to true in public/index.html.
# LOGO_URL=https://example.com/your-logo.png
