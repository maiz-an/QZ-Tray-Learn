{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/digital-certificate.txt", "destination": "/api/cert" },
    { "source": "/sign-message",            "destination": "/api/sign" },
    { "source": "/logo-base64",             "destination": "/api/logo" },
    { "source": "/(.*)",                    "destination": "/index.html" }
  ]
}